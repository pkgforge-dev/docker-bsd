# The image IMG-01 publishes: a container that BOOTS a BSD.
#
# ⛔ IT FETCHES NOTHING AT RUN TIME. The emulator, the guest kernel and the
# guest root filesystem are all in layers, so a consumer with no network and no
# emulator installed still reaches a BSD shell. The experiment this came from
# downloaded all three at run time from a bind mount, which is what made it an
# experiment and what would have made this a liability.
#
# ⛔ EVERY ARTEFACT IS PINNED. The base by its manifest digest, the two guest
# artefacts by SHA-256, and scripts/sources is the one place any of those
# values is written. A build with no --build-arg fails at the FROM line rather
# than silently taking a moving tag.
#
# ⚠ ONE THING IS NOT PINNED AND IT IS LABELLED RATHER THAN HIDDEN: the emulator
# comes from Alpine's package repository, which is a branch and not a snapshot.
# There is no snapshot service to pin to. The resolved version is written into
# /opt/bsd/evidence.txt in the image, so a build that behaves differently from
# another can be told apart afterwards.

ARG BASE

# ── fetch and verify, in a stage that does not ship ─────────────────────────
FROM ${BASE} AS fetch

ARG KERNEL_URL
ARG KERNEL_SHA256
ARG ROOTFS_URL
ARG ROOTFS_SHA256
ARG ROOT_LABEL
ARG ROOTFS_SIZE
ARG PACKAGE_URL
ARG PACKAGE_SHA256
ARG BENCH_URL
ARG BENCH_SHA256

RUN apk add --no-cache curl xz e2fsprogs e2fsprogs-extra sgdisk

WORKDIR /art

# ⛔ THE DIGEST IS CHECKED BEFORE THE FILE IS USED, AND THERE IS NO WAY PAST IT.
# sha256sum -c is the last command in each pipeline, so the exit code the shell
# reads is its own. An upstream that rotates a release under a moving tag fails
# this build loudly, which is the intended behaviour and not a defect.
RUN curl -fsSL -o kernel "$KERNEL_URL" \
 && echo "$KERNEL_SHA256  kernel" | sha256sum -c -

# ⚠ The names are generic because the variants are not. One definition builds
# both, and a filename carrying `rescue` would be wrong in half of them.
RUN curl -fsSL -o rootfs.img.xz "$ROOTFS_URL" \
 && echo "$ROOTFS_SHA256  rootfs.img.xz" | sha256sum -c - \
 && xz -d rootfs.img.xz

# ⭐ THE GUEST'S PACKAGE IS FETCHED HERE, BY LINUX, AT THE CONTAINER'S OWN
# NETWORK SPEED. Letting the guest fetch it through an emulated network stack
# was measured on 2026-08-27 and took longer than every other step in this file
# put together. ⛔ The URL carries a version and the digest is checked, which
# `pkg_add <name>` inside the guest could do neither of.
RUN mkdir -p /inject \
 && if [ -n "$PACKAGE_URL" ]; then \
      curl -fsSL -o /inject/guest-package.tgz "$PACKAGE_URL" \
   && echo "$PACKAGE_SHA256  /inject/guest-package.tgz" | sha256sum -c -; \
    else \
      echo "no package asked for"; \
    fi

# ⭐ THE BENCHMARK'S SOURCE GOES IN THE SAME WAY, FOR A HARDER REASON. `-v` does
# not reach the guest, so nothing can hand it a source tree at run time at all.
# ⛔ Without this, the only compile anybody could time inside the guest is one
# typed at a serial console, one character at a time.
#
# ⚠ Two files out of the archive rather than the archive: the guest would have
# to unpack it otherwise, and unpacking is not the thing being measured.
RUN mkdir -p /bench \
 && if [ -n "$BENCH_URL" ]; then \
      curl -fsSL -o bench.tar.gz "$BENCH_URL" \
   && echo "$BENCH_SHA256  bench.tar.gz" | sha256sum -c - \
   && tar xzf bench.tar.gz \
   && cp ./sqlite-*/sqlite3.c /inject/sqlite3.c \
   && cp ./sqlite-*/sqlite3.h /inject/sqlite3.h \
   && cp /inject/sqlite3.c /inject/sqlite3.h /bench/ \
   && rm -rf bench.tar.gz ./sqlite-*; \
    else \
      echo "no benchmark source asked for"; \
    fi

# ⭐ GROWN HERE, BY LINUX, BECAUSE THE GUEST'S ROOT IS ext2 AND NOT FFS. A BSD
# filesystem would need a booted BSD to resize it. ⚠ An empty ROOTFS_SIZE means
# leave it alone, which is what the rescue variant wants: it is a shell in
# seconds and nothing is ever installed into it.
#
# ⚠ Everything in /inject goes in on the same pass. The filesystem is already
# extracted at that point, so writing files into it is free.
COPY images/netbsd/grow-rootfs.sh /grow-rootfs.sh
RUN if [ -n "$ROOTFS_SIZE" ]; then \
      sh /grow-rootfs.sh rootfs.img "$ROOTFS_SIZE" "$ROOT_LABEL" /inject; \
    else \
      echo "grow-rootfs: no size asked for, leaving the root filesystem alone"; \
    fi

# ── provision: install into the guest by BOOTING it ────────────────────────
#
# ⛔ A CONSUMER MUST NOT HAVE TO INSTALL A COMPILER. `--rm` throws away
# everything they install, so a package added at run time is paid for on every
# single run and owned by nobody. It goes in here, once, and ships.
#
# ⚠ THIS STAGE RUNS AN EMULATOR INSIDE A CONTAINER BUILD, unaccelerated,
# because a build has no /dev/kvm. It is the slowest step in this file by a
# wide margin and it is why the timeout on the workflow job is generous.
FROM ${BASE} AS provision

ARG ROOT_LABEL
ARG PACKAGES

RUN apk add --no-cache qemu-system-x86_64 python3

COPY --from=fetch /art/kernel /guest/kernel
COPY --from=fetch /art/rootfs.img /guest/rootfs.img
COPY experiments/lib/console.py /opt/bsd/console.py
COPY images/netbsd/guest.py /opt/bsd/guest.py
COPY images/netbsd/entrypoint.sh /opt/bsd/entrypoint.sh

ENV BSD_ROOT_LABEL="${ROOT_LABEL}"
ENV BSD_CMD_TIMEOUT="3000"

# ⚠ MORE MEMORY THAN A CONSUMER GETS, AND ONLY HERE. The default 256 MB is
# ample for reaching a shell and is the wrong size for unpacking half a
# gigabyte into an emulated filesystem, where the guest spends its time
# evicting cache instead of writing. This is a build step, not a run, so the
# memory costs the consumer nothing.
ENV BSD_MEM="1024"

# ⛔ NO NETWORK IN THIS STAGE, ON PURPOSE. The package is already inside the
# guest's filesystem, so installing it is a local file operation. A stage that
# could still reach a repository is a stage that might quietly start doing so
# again, and the difference would show up as an hour of build time nobody
# ordered.
ENV BSD_NET="none"

# ⛔ THE GUEST SYNCS AND REMOUNTS ITS ROOT READ ONLY BEFORE THE EMULATOR IS
# STOPPED. The console driver's stop sends `halt -p` and then terminates the
# process, and a filesystem still holding dirty buffers at that moment is a
# filesystem shipped in an unknown state. This is the one place in this
# repository where an unclean shutdown would be baked into a release.
RUN chmod +x /opt/bsd/entrypoint.sh \
 && if [ -n "$PACKAGES" ]; then \
      /opt/bsd/entrypoint.sh sh -c "pkg_add -U $PACKAGES && rm -f $PACKAGES && df -h / && sync && sync && mount -u -r /"; \
    else \
      echo "provision: no packages asked for"; \
    fi

# ── what ships ──────────────────────────────────────────────────────────────
FROM ${BASE}

ARG KERNEL_URL
ARG KERNEL_SHA256
ARG ROOTFS_URL
ARG ROOTFS_SHA256
ARG ROOT_LABEL
ARG ROOTFS_SIZE
ARG PACKAGES
ARG NET
ARG VARIANT
ARG SOURCE_COMMIT=unknown

LABEL org.opencontainers.image.title="netbsd" \
      org.opencontainers.image.description="A NetBSD shell in one podman run, on any host with a container engine and nothing else." \
      org.opencontainers.image.source="https://github.com/pkgforge-dev/docker-bsd" \
      org.opencontainers.image.licenses="0BSD" \
      org.opencontainers.image.revision="${SOURCE_COMMIT}"

RUN apk add --no-cache qemu-system-x86_64 python3

COPY --from=fetch /art/kernel /guest/kernel
COPY --from=provision /guest/rootfs.img /guest/rootfs.img

# ⭐ THE BENCHMARK'S SOURCE IS ALSO CARRIED IN THE CONTAINER, NOT ONLY IN THE
# GUEST, AND THAT IS WHAT MAKES THE COMPARISON FAIR. The other side of the
# measurement is the same compiler family on Linux, and it has to compile THE
# SAME BYTES. Two copies of one file inside one image is not a duplicated fact:
# it is the same file on both sides of an experiment, which is the point.
#
# ⚠ Empty on the variant that has no compiler, because a COPY cannot be
# conditional and a missing path fails the build.
COPY --from=fetch /bench /bench

# ⛔ THE ROOT LABEL IS BAKED, NOT GUESSED. It is the GPT partition name the
# guest kernel is told to mount, it differs per variant, and a wrong one boots
# a kernel that never finds its disk.
ENV BSD_ROOT_LABEL="${ROOT_LABEL}"

# ⚠ THE VARIANT THAT HAS A PACKAGE MANAGER SHIPS WITH A NETWORK, AND THE ONE
# THAT DOES NOT SHIPS WITHOUT. A package manager that cannot reach a repository
# is a package manager that cannot do its one job. It is a user-mode stack, so
# it needs no privilege and opens no port, and `--network none` on the
# container still cuts it off completely.
ENV BSD_NET="${NET}"

# ⛔ console.py IS COPIED FROM experiments/lib, NOT DUPLICATED HERE. It is this
# repository's single copy of two measured tty rules: type one character at a
# time, and compare an echo with whitespace removed. A second copy is a second
# place for one of them to be lost.
COPY experiments/lib/console.py /opt/bsd/console.py
COPY images/netbsd/guest.py /opt/bsd/guest.py
COPY images/netbsd/entrypoint.sh /opt/bsd/entrypoint.sh

RUN chmod +x /opt/bsd/entrypoint.sh \
 && { \
      echo "image      netbsd"; \
      echo "variant    ${VARIANT}"; \
      echo "rootlabel  ${ROOT_LABEL}"; \
      echo "rootsize   ${ROOTFS_SIZE:-as published}"; \
      echo "packages   ${PACKAGES:-none}"; \
      echo "network    ${NET}"; \
      echo "revision   ${SOURCE_COMMIT}"; \
      echo "kernel     ${KERNEL_URL}"; \
      echo "kernel     sha256:${KERNEL_SHA256}"; \
      echo "rootfs     ${ROOTFS_URL}"; \
      echo "rootfs     sha256:${ROOTFS_SHA256}"; \
      echo "emulator   $(qemu-system-x86_64 --version | head -n 1)"; \
      echo "python     $(python3 --version)"; \
      echo "alpine     $(cat /etc/alpine-release)"; \
    } > /opt/bsd/evidence.txt

# ⚠ -it is the only flag a consumer needs, and it is needed because what they
# are being handed is a console. CMD is a bare shell name because that is what
# a person types, and guest.py reads it as "give me the console".
ENTRYPOINT ["/opt/bsd/entrypoint.sh"]
CMD ["sh"]
